# ─── Stock Market Toolkit ─── #
# Copy this to .env and fill in your values

# Database (postgresql+asyncpg format)
POSTGRES_PASSWORD=your-secure-password-here

# JWT Secret (generate with: openssl rand -hex 64)
SECRET_KEY=your-secure-secret-key-here

# CORS Origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3030,http://localhost:5173

# Public URL of the frontend, used to build links in Discord/email
# notifications (e.g. the alert title hyperlink). Leave empty to disable links.
FRONTEND_URL=https://stock.example.com

# Log Level
LOG_LEVEL=INFO
